# Cell AI Research - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# cp .env.example .env

# ==========================================
# 1. Academic Evaluation Channels (JEV / System One)
# ==========================================

# TypeSafe Jev (Official System One channel)
# Get key: https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-preview

# Codiv OpenJev (Open-weight weights channel)
# Get key: https://console.codiv.ai/
CODIV_API_KEY=your_codiv_api_key_here
CODIV_MODEL=openjev-latest

# SubQ (System One Snap channel)
# Get key: https://api.subq.ai/
SUBQ_API_KEY=your_subq_api_key_here
SUBQ_MODEL=subq-snap-1.2

# Cloudflare Workers AI Clef (Edge fallback)
# Get token: https://dash.cloudflare.com/
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_CLEF_MODEL=clef-flash

# ==========================================
# 2. Local / Gateway LLM Services
# ==========================================
# Backend jobs (index translation, summaries, subagents). Keep these on a private gateway.
CELL_AI_LLM_BASE=http://10.0.0.240:8080/v1
CELL_AI_LLM_MODEL=stable
CELL_AI_LLM_API_KEY=your_gateway_key_here

# Site-wide default shown in the browser Copilot. The published page embeds only base and
# model; never put a secret key here. Visitors can set their own base/model/key in the
# Copilot "接口设置" dialog, stored solely in their browser localStorage.
CELL_AI_BROWSER_LLM_BASE=https://your-public-gateway.example.com/v1
CELL_AI_BROWSER_LLM_MODEL=fast

# ==========================================
# 3. Cloudflare Pages Deployment (Optional)
# ==========================================
CLOUDFLARE_API_TOKEN=your_cloudflare_pages_deploy_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
