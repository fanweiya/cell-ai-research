# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Cloudflare Pages build artifacts & local Wrangler cache
.cf-pages-site/
.wrangler/

# 站点索引与论文数据库由 generate_index.py / verified_daily.py 生成
/index.html
/papers.json

# Large figure originals cache (>1GB, fetched incrementally from arXiv HTML)
data/figures/originals/
# 图注索引、预览图与图解页均由 generate_index.py / add_paper_figures.py 重建
data/figures/

# Log files and run logs
*.png
*.jpg
*.jpeg
logs/
*.log

# Temporary runtime states and caches
tmp/
.site-update-pending.json
*.tmp

# 运行证据快照（papers-before-*.json / run-*.json），体积随每次运行增长，不入库
data/evidence/
# 每日运行的证据目录（备份、运行快照、待重试标记）
/evidence/

# 论文上下文、图解中间产物与运行分析结果（均由采集与分析脚本生成，体积大）
data/paper_context/
data/explainers/
results/

# 解读页的页面源（可由底稿重新渲染，体积大）
data/explainers/src/

# Environment variables and secrets
.env
.env.*
!.env.example
*.lock

# Node dependencies
node_modules/

# OS generated files
.DS_Store
Thumbs.db
.explainer-config.json

# 代理生成图解页的中间工作目录（克隆的仓库、截图、草稿）
data/explainers/agent/
# 图解页成品（由底稿渲染，600 篇约 40 MB，发布时从工作区复制）
/explainers/

# 图解页中间底稿、并发锁
data/explainers/brief/
data/explainers/.run.lock

# 技能副本（vendored visual-explainer，自带 git 仓库）
tools/visual-explainer/
